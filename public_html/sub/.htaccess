RewriteEngine On

# Redirect root → /home
RewriteCond %{THE_REQUEST} \s/+\s [NC]
RewriteRule ^$ /home [L,R=301]

# Home
RewriteRule ^home$ index.html [L]

# Static pages
RewriteRule ^about$ about.html [L]
RewriteRule ^cart$ cart.html [L]
RewriteRule ^choose-us$ choose-us.html [L]
RewriteRule ^ghee$ ghee.html [L]
RewriteRule ^gir-cow-ghee$ gir-cow-ghee.html [L]
RewriteRule ^orders$ orders.html [L]
RewriteRule ^product$ product.html [L]
RewriteRule ^profile$ profile.html [L]
RewriteRule ^red-chilly-sauce$ red-chilly-sauce.html [L]
RewriteRule ^sign-up$ sign-up.html [L]