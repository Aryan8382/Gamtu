<!-- STORY with COUNTERS -->
<section class="story-section">
  <div class="story-layout">
    <div class="story-video-wrap reveal">
      <video src="https://gamtuindia.com/wp-content/uploads/2026/04/1e92f27fba9741be9baf9a35278bc79e.webm" autoplay loop muted playsinline preload="auto"></video>
    </div>
    <div class="story-inner reveal" style="transition-delay:.14s">
      <h2 class="story-title">Quality You Can Trust<br/></h2>
      <p class="story-text">At Gamtu we source our products directly from the roots from farmers across the india. 
Our founder personally selects and takes care of every small detail, ensuring that each batch is carefully crafted in small quantities so you receive pure, natural ingredients!</p>
      <div class="story-stats">
