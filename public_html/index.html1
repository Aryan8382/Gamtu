<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Gamtu — Pure. Traditional. Wholesome.</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
<style>
*{box-sizing:border-box;margin:0;padding:0;}
:root{
  --brown:#432514;--brown2:#5a3a28;--brown3:#2e1a0e;
  --sand:#cab9a7;--sand-light:rgba(202,185,167,0.3);
  --cream:#faf6f1;--white:#fff;--gold:#c9a84c;--gold2:#e8c97a;
  --btn-qty-bg:linear-gradient(135deg,#ff6b2b 0%,#f5a623 60%,#ffd700 100%);
  --btn-qty-hover:linear-gradient(135deg,#e85a1a 0%,#e09510 60%,#f0c800 100%);
  --btn-qty-color:#3a1800;
  --btn-cart-bg:linear-gradient(135deg,#1a6b3a 0%,#22a05a 60%,#00c98c 100%);
  --btn-cart-hover:linear-gradient(135deg,#145a2e 0%,#1a8a48 60%,#00b07a 100%);
  --btn-cart-color:#fff;
  --btn-count-bg:linear-gradient(135deg,#1e3d2f 0%,#1a5e3a 100%);
  --nav-h:78px;
}
html{scroll-behavior:smooth;}
body{font-family:"Cormorant Garamond",sans-serif;background:#fff;overflow-x:hidden;}
body.intro-active{overflow:hidden;}
/* Add this new rule right after */
body.intro-active #introOverlay ~ *{
  visibility:visible;
}

@keyframes slideLeft{
  from{opacity:0;transform:translateX(-50px);}
  to{opacity:1;transform:translateX(0);}
}

@keyframes slideRight{
  from{opacity:0;transform:translateX(50px);}
  to{opacity:1;transform:translateX(0);}
}

@keyframes float{
  0%,100%{transform:translateY(0);}
  50%{transform:translateY(-12px);}
}

@keyframes marquee{
  from{transform:translateX(0);}
  to{transform:translateX(-50%);}
}

@keyframes fadeUp{
  from{opacity:0;transform:translateY(24px);}
  to{opacity:1;transform:translateY(0);}
}

@keyframes spin{
  to{transform:rotate(360deg);}
}

#introOverlay{
  position:fixed;
  inset:0;
  z-index:99999;
  background:transparent;
  display:flex;
  align-items:center;
  justify-content:center;
  transition:opacity 1.6s ease, visibility 1.6s ease;
  overflow:hidden;
}

#introOverlay.fade-out{
  opacity:0;
  visibility:hidden;
  pointer-events:none;
}

/* VIDEO */
#introOverlay video{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
  z-index:1;
}

/* Stop excessive scaling on very large screens */
@media (min-width: 1400px) {
  #introOverlay video{
    object-fit:contain;
  }
}

#introProgress{
  position:absolute;
  bottom:0;
  left:0;
  height:3px;
  width:0%;
  background:linear-gradient(90deg,var(--gold),#fff8);
  z-index:3;
  transition:none;
}

#introProgress.run{
  transition:width 5s linear;
  width:100%;
}
.reveal{opacity:0;transform:translateY(32px);transition:opacity .65s ease,transform .65s ease;}
.reveal.visible{opacity:1;transform:translateY(0);}

/* ══ NAVBAR ══ */
.navbar{position:fixed;top:0;width:100%;height:var(--nav-h);display:flex;align-items:center;justify-content:space-between;padding:0 40px;background:#fef9f4;border-bottom:1.5px solid rgba(202,185,167,0.55);box-shadow:0 2px 18px rgba(67,37,20,0.07);z-index:1000;transition:box-shadow .3s,background .3s;}
.navbar.scrolled{background:rgba(254,249,244,.97);box-shadow:0 4px 28px rgba(67,37,20,.12);backdrop-filter:blur(10px);}
.nav-logo img{height:100px;display:block;transition:transform .3s;}
.nav-logo img:hover{transform:scale(1.05);}
body.intro-active .nav-logo img{
  opacity:0;
  transform:scale(0.85);
  transition:opacity .6s ease, transform .6s ease;
}
/* Show logo when intro ends (intro-active removed) */
.nav-logo img {
  opacity: 1;
  transform: scale(1);
  transition: opacity 0.6s ease, transform 0.6s ease;
}
.nav-links{display:flex;align-items:center;gap:30px;flex:1;justify-content:center;}
.nav-links a{text-decoration:none;color:var(--brown);font-size:22px;font-weight:500;position:relative;transition:color .25s;white-space:nowrap;}
.nav-links a::after{content:"";position:absolute;left:0;bottom:-4px;width:0;height:2px;background:var(--gold);transition:width .28s;border-radius:2px;}
.nav-links a:hover{color:var(--brown3);}
.nav-links a:hover::after,.nav-links a.active::after{width:100%;}
.nav-links a.active{color:var(--brown3);font-weight:700;}
.nav-dd{position:relative;}
.nav-dd-btn{display:flex;align-items:center;gap:4px;color:var(--brown);font-size:22px;font-weight:500;cursor:pointer;transition:color .25s;white-space:nowrap;background:none;border:none;font-family:"Cormorant Garamond",sans-serif;padding:0;position:relative;}
.nav-dd-btn::after{content:"";position:absolute;left:0;bottom:-4px;width:0;height:2px;background:var(--gold);transition:width .28s;border-radius:2px;}
.nav-dd:hover .nav-dd-btn::after,.nav-dd.open .nav-dd-btn::after{width:calc(100% - 14px);}
.nav-dd:hover .nav-dd-btn,.nav-dd.open .nav-dd-btn{color:var(--brown3);}
.chevron{font-size:9px;opacity:.5;transition:transform .28s;}
.nav-dd.open .chevron{transform:rotate(180deg);}
.nav-dd-menu{position:absolute;top:calc(100% + 14px);left:50%;transform:translateX(-50%) translateY(5px);min-width:196px;background:#fff;border-radius:15px;padding:8px;box-shadow:0 16px 44px rgba(67,37,20,.16),0 3px 10px rgba(0,0,0,.06);border:1px solid rgba(202,185,167,.3);opacity:0;visibility:hidden;transition:all .24s cubic-bezier(.4,0,.2,1);z-index:9999;pointer-events:none;}
.nav-dd-menu::before{content:"";position:absolute;top:-5px;left:50%;transform:translateX(-50%) rotate(45deg);width:10px;height:10px;background:#fff;border-left:1px solid rgba(202,185,167,.3);border-top:1px solid rgba(202,185,167,.3);}
.nav-dd:hover .nav-dd-menu,.nav-dd.open .nav-dd-menu{opacity:1;visibility:visible;transform:translateX(-50%) translateY(0);pointer-events:auto;}
.nav-dd-menu a{display:flex;align-items:center;gap:8px;padding:10px 13px;font-size:14px;font-weight:500;color:var(--brown);text-decoration:none;border-radius:9px;transition:all .2s;}
.nav-dd-menu a:hover{background:var(--cream);color:var(--brown3);}
.nav-right{display:flex;align-items:center;gap:12px;flex-shrink:0;}
.profile-wrap{position:relative;}
.profile-btn{display:flex;align-items:center;gap:8px;cursor:pointer;padding:7px 13px 7px 9px;border-radius:24px;background:none;border:none;font-family:"Cormorant Garamond",sans-serif;font-size:14px;font-weight:600;color:var(--brown);transition:all .22s;}
.profile-btn{
    display:flex;
    align-items:center;
    gap:10px;
    cursor:pointer;
    padding:10px 16px 10px 12px;
    border-radius:30px;
    background:none;
    border:none;
    font-family:"Cormorant Garamond",sans-serif;
    font-size:18px;
    font-weight:600;
    color:var(--brown);
    transition:all .22s;
}

.profile-avatar{
    width:38px;
    height:38px;
    border-radius:50%;
    background:linear-gradient(135deg,var(--brown),var(--gold));
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:18px;
    color:#fff;
    flex-shrink:0;
}

.profile-name{
    max-width:130px;
    font-size:18px;
    font-weight:600;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
}
.profile-drop{position:absolute;top:calc(100% + 10px);right:0;min-width:166px;background:#fff;border-radius:13px;padding:7px;box-shadow:0 16px 44px rgba(67,37,20,.15);border:1px solid rgba(202,185,167,.28);opacity:0;visibility:hidden;transition:all .24s cubic-bezier(.4,0,.2,1);z-index:9999;pointer-events:none;transform:translateY(5px);}
.profile-wrap:hover .profile-drop,.profile-wrap.open .profile-drop{opacity:1;visibility:visible;transform:translateY(0);pointer-events:auto;}
.profile-drop a{display:flex;align-items:center;gap:8px;padding:10px 12px;font-size:13.5px;font-weight:500;color:var(--brown);text-decoration:none;border-radius:8px;transition:all .2s;}
.profile-drop a:hover{background:var(--cream);}
.nav-login{padding:8px 19px;border-radius:22px;background:var(--brown);color:#fff;font-size:14px;font-weight:600;text-decoration:none;transition:all .24s;border:none;cursor:pointer;font-family:"Cormorant Garamond",sans-serif;box-shadow:0 4px 13px rgba(67,37,20,.24);}
.nav-login:hover{background:var(--brown3);transform:translateY(-2px);}
.cart-btn{
    display:flex;
    align-items:center;
    gap:10px;
    padding:11px 22px;
    border-radius:30px;
    background:var(--btn-cart-bg);
    color:#fff;
    font-size:18px;
    font-weight:600;
    border:none;
    cursor:pointer;
    font-family:"Cormorant Garamond",sans-serif;
    transition:all .24s;
    box-shadow:0 4px 13px rgba(26,107,58,.26);
    white-space:nowrap;
}

.cart-count{
    min-width:26px;
    height:26px;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    background:rgba(255,255,255,.22);
    font-size:14px;
    font-weight:700;
    padding:0;
}
.cart-btn:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(26,107,58,.38);}
.hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;background:none;border:none;padding:5px;z-index:1010;flex-shrink:0;}
.hamburger span{display:block;width:23px;height:2px;background:var(--brown);border-radius:2px;transition:all .28s;}
.hamburger.open span:nth-child(1){transform:rotate(45deg) translate(5px,5px);}
.hamburger.open span:nth-child(2){opacity:0;transform:scaleX(0);}
.hamburger.open span:nth-child(3){transform:rotate(-45deg) translate(5px,-5px);}
.mob-menu{position:fixed;top:var(--nav-h);left:0;width:100%;background:rgba(254,249,244,.99);backdrop-filter:blur(14px);border-bottom:1.5px solid rgba(202,185,167,.4);box-shadow:0 14px 38px rgba(67,37,20,.1);z-index:998;flex-direction:column;padding:12px 22px 20px;gap:2px;opacity:0;transform:translateY(-6px);transition:all .28s cubic-bezier(.4,0,.2,1);pointer-events:none;display:flex;visibility:hidden;}
.mob-menu.open{opacity:1;transform:translateY(0);pointer-events:auto;visibility:visible;}
.mob-menu a,.mob-toggle{display:flex;align-items:center;justify-content:space-between;padding:12px 2px;border:none;border-bottom:1px solid rgba(202,185,167,.22);color:var(--brown);font-size:15.5px;font-weight:600;text-decoration:none;transition:color .2s;background:none;font-family:"Cormorant Garamond",sans-serif;cursor:pointer;width:100%;text-align:left;}
.mob-menu a:hover,.mob-toggle:hover{color:var(--brown3);}
.mob-menu a.active{color:var(--gold);font-weight:700;}
.mob-sub{display:none;flex-direction:column;padding:2px 0 4px 14px;gap:1px;border-bottom:1px solid rgba(202,185,167,.18);}
.mob-sub.open{display:flex;}
.mob-sub a{border:none;padding:9px 2px;font-size:14px;font-weight:500;color:#7a5a3a;}
.mob-bottom{display:flex;gap:9px;margin-top:12px;}
.mob-bottom .nav-login{flex:1;text-align:center;}
.mob-bottom .cart-btn{flex:1;}
@media(max-width:880px){.hamburger{display:flex;}.nav-links,.nav-right>.profile-wrap,.nav-right>.nav-login{display:none!important;}.navbar{padding:0 18px;}}
@media(max-width:480px){.nav-logo img{height:46px;}.navbar{padding:0 14px;}}

/* ══ CAROUSEL ══ */
.hero-section{position:relative;margin-top:var(--nav-h);}
.carousel-wrap{position:relative;overflow:hidden;width:100%;height:520px;}
.carousel-track{display:flex;height:100%;transition:transform .8s cubic-bezier(.4,0,.2,1);will-change:transform;}
.carousel-slide{min-width:100%;height:520px;display:flex;align-items:center;justify-content:flex-start;padding:50px 8%;position:relative;overflow:hidden;flex-shrink:0;}
.slide-bg-1{background:linear-gradient(120deg,#f5ede3 0%,#e3cbb8 55%,#d0af94 100%);}
.slide-bg-2{background:linear-gradient(120deg,#e5f0e0 0%,#c3d9ae 55%,#a8c88a 100%);}
.slide-bg-3{background:linear-gradient(120deg,#fdf3e3 0%,#f5ddb0 55%,#e8c36a 100%);}
.slide-bg-4{background:linear-gradient(120deg,#ede8f5 0%,#ccc0ea 55%,#b0a2d9 100%);}
.slide-bg-5{background:linear-gradient(120deg,#fde8ea 0%,#f5bdc3 55%,#e898a2 100%);}
.carousel-slide::before{content:"";position:absolute;right:-100px;top:-100px;width:450px;height:450px;border-radius:50%;background:rgba(255,255,255,.14);pointer-events:none;z-index:1;}
.carousel-slide::after{content:"";position:absolute;left:-80px;bottom:-80px;width:320px;height:320px;border-radius:50%;background:rgba(255,255,255,.1);pointer-events:none;z-index:1;}
.slide-content{position:relative;z-index:3;flex:1;padding-right:40px;text-align:left;max-width:600px;}
.slide-tag{display:inline-flex;align-items:center;gap:7px;background:var(--brown);color:#fff;font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;padding:6px 16px;border-radius:30px;margin-bottom:18px;box-shadow:0 4px 14px rgba(67,37,20,.3);}
.slide-content h2{font-family:"Cormorant Garamond",serif;font-size:52px;line-height:1.12;color:var(--brown);margin-bottom:14px;font-weight:700;}
.slide-content p{font-size:15px;color:#7a6a5c;line-height:1.8;margin-bottom:24px;max-width:420px;}
.slide-price{font-size:30px;font-weight:700;color:var(--brown);margin-bottom:26px;font-family:"Cormorant Garamond",serif;}
.slide-price span{font-size:14px;font-weight:400;color:#9a8070;}
.slide-btns{display:flex;gap:14px;align-items:center;flex-wrap:wrap;}
.slide-btn-primary{padding:14px 34px;border-radius:30px;background:var(--brown);color:#fff;font-size:14px;font-weight:600;border:none;cursor:pointer;transition:all .3s;box-shadow:0 6px 20px rgba(67,37,20,.3);}
.slide-btn-primary:hover{background:var(--brown3);transform:translateY(-3px);}
.slide-btn-secondary{padding:14px 28px;border-radius:30px;background:transparent;color:var(--brown);font-size:14px;font-weight:600;border:2px solid var(--brown);cursor:pointer;transition:all .3s;}
.slide-btn-secondary:hover{background:var(--brown);color:#fff;}
.slide-image{flex-shrink:0;position:relative;z-index:3;cursor:pointer;}
.slide-image img{width:320px;height:320px;object-fit:contain;filter:drop-shadow(0 22px 44px rgba(67,37,20,.22));animation:float 4s ease-in-out infinite;}
.carousel-slide.is-active .slide-content{animation:slideLeft .65s ease both;}
.carousel-slide.is-active .slide-image{animation:slideRight .65s ease both;}
.carousel-arrow{position:absolute;top:50%;transform:translateY(-50%);background:rgba(255,255,255,.94);color:var(--brown);border:none;width:50px;height:50px;border-radius:50%;cursor:pointer;z-index:10;font-size:20px;font-weight:800;box-shadow:0 6px 22px rgba(0,0,0,.14);transition:all .3s;display:flex;align-items:center;justify-content:center;}
.carousel-arrow:hover{background:var(--brown);color:#fff;transform:translateY(-50%) scale(1.1);}
.arrow-prev{left:22px;}
.arrow-next{right:22px;}
.carousel-dots{position:absolute;bottom:22px;left:50%;transform:translateX(-50%);display:flex;gap:9px;z-index:10;}
.carousel-dots span{width:9px;height:9px;border-radius:50%;background:rgba(67,37,20,.28);cursor:pointer;transition:all .4s;display:inline-block;}
.carousel-dots span.active{background:var(--brown);width:30px;border-radius:5px;}
.carousel-progress{position:absolute;bottom:0;left:0;height:3px;background:var(--brown);width:0%;z-index:10;transition:none;}
.carousel-progress.run{transition:width 4.5s linear;width:100%;}

@media(max-width:1024px){
  .carousel-wrap{height:460px;}
  .carousel-slide{height:460px;padding:40px 6%;}
  .slide-content h2{font-size:38px;}
  .slide-image img{width:240px;height:240px;}
}
@media(max-width:767px){
  .carousel-wrap{height:auto;min-height:420px;}
  .carousel-slide{padding:32px 20px 70px;flex-direction:column;gap:16px;height:auto;min-height:420px;text-align:center;align-items:center;justify-content:center;}
  .slide-content{padding-right:0;order:2;width:100%;}
  .slide-image{order:1;}
  .slide-content h2{font-size:26px;margin-bottom:8px;}
  .slide-content p{font-size:13px;max-width:100%;margin-bottom:14px;}
  .slide-price{font-size:22px;margin-bottom:16px;}
  .slide-tag{font-size:10px;padding:5px 12px;margin-bottom:10px;}
  .slide-image img{width:140px;height:140px;}
  .slide-btns{justify-content:center;gap:10px;}
  .slide-btn-primary{padding:11px 24px;font-size:13px;}
  .slide-btn-secondary{padding:11px 20px;font-size:13px;}
  .carousel-arrow{width:34px;height:34px;font-size:14px;}
  .arrow-prev{left:8px;}
  .arrow-next{right:8px;}
  .carousel-dots{bottom:16px;}
}
@media(max-width:420px){
  .carousel-slide{padding:24px 16px 60px;gap:12px;min-height:380px;}
  .slide-content h2{font-size:22px;}
  .slide-image img{width:120px;height:120px;}
  .slide-btn-primary,.slide-btn-secondary{padding:10px 18px;font-size:12px;}
}

/* ══ MARQUEE ══ */
.marquee-bar{background:var(--brown);padding:13px 0;overflow:hidden;}
.marquee-inner{display:flex;gap:0;width:max-content;animation:marquee 28s linear infinite;}
.marquee-item{display:flex;align-items:center;gap:10px;color:rgba(255,255,255,.9);font-size:13px;font-weight:500;white-space:nowrap;padding:0 44px;border-right:1px solid rgba(255,255,255,.15);}
.marquee-item .mi{color:var(--gold2);font-size:17px;}
@media(max-width:600px){.marquee-item{padding:0 28px;font-size:12px;}}

/* ══ SECTION COMMONS ══ */
.section-eyebrow{display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:3px;color:var(--gold);opacity:.85;margin-bottom:10px;}
.section-title{font-family:"Cormorant Garamond",serif;font-size:45px;color:var(--brown);margin-bottom:10px;line-height:1.2;font-weight:700;}
.section-sub{font-size:14px;color:#9a8070;margin-bottom:48px;}
.underline-bar{width:54px;height:2px;background:linear-gradient(90deg,var(--gold),var(--brown));margin:12px auto 0;border-radius:2px;}
.section-header{text-align:center;margin-bottom:48px;}
@media(max-width:600px){.section-title{font-size:30px;}.section-header{margin-bottom:32px;}}

/* ══ FILTER PILLS ══ */
.filter-pills-section{
  padding:32px 40px 0;
  background:#fff;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:0;
}
.filter-pills-label{
  font-family:"Cormorant Garamond",serif;
  font-size:13px;
  font-weight:700;
  letter-spacing:3px;
  text-transform:uppercase;
  color:#111;
  margin-bottom:16px;
  opacity:1;
}
.filter-pills{
  display:flex;
  flex-wrap:nowrap;
  gap:12px;
  justify-content:center;
  max-width:1100px;
  width:100%;
}
.filter-pill{
  display:inline-flex;
  flex-direction:row;
  align-items:center;
  gap:8px;
  padding:12px 22px;
  border-radius:50px;
  border:none;
  text-decoration:none;
  cursor:pointer;
  transition:all .3s cubic-bezier(.4,0,.2,1);
  box-shadow:0 4px 16px rgba(0,0,0,.12);
  white-space:nowrap;
  position:relative;
  overflow:hidden;
}
.filter-pill::before{
  content:"";
  position:absolute;
  inset:0;
  background:rgba(255,255,255,.12);
  opacity:0;
  transition:opacity .3s;
}
.filter-pill:hover::before{opacity:1;}
.filter-pill:hover{transform:translateY(-5px);box-shadow:0 12px 30px rgba(0,0,0,.18);}
.filter-pill .pill-icon{font-size:20px;line-height:1;filter:drop-shadow(0 2px 4px rgba(0,0,0,.15));}
.filter-pill .pill-name{
  font-family:"Cormorant Garamond",serif;
  font-size:17px;
  font-weight:700;
  color:#fff;
  letter-spacing:.3px;
}
.filter-pill.pill-organic{background:linear-gradient(135deg,#2e7d32 0%,#66bb6a 100%);}
.filter-pill.pill-kansa{background:linear-gradient(135deg,#7a5c00 0%,#e8c97a 100%);}
.filter-pill.pill-jain{background:linear-gradient(135deg,#e65100 0%,#ffa726 100%);}
.filter-pill.pill-satvik{background:linear-gradient(135deg,#6a1b9a 0%,#ce93d8 100%);}
.filter-pill.pill-instant{background:linear-gradient(135deg,#01579b 0%,#4fc3f7 100%);}
.filter-pill.pill-healthy{background:linear-gradient(135deg,#00695c 0%,#4db6ac 100%);}
@media(max-width:768px){
  .filter-pills-section{padding:24px 16px 0;}
  .filter-pills{gap:8px;}
  .filter-pill{padding:10px 16px;border-radius:50px;}
  .filter-pill .pill-icon{font-size:17px;}
  .filter-pill .pill-name{font-size:14px;}
}
@media(max-width:480px){
  .filter-pills-section{padding:16px 10px 0;}
  .filter-pills{gap:6px;flex-wrap:wrap;}
  .filter-pill{padding:8px 14px;}
  .filter-pill .pill-icon{font-size:15px;}
  .filter-pill .pill-name{font-size:13px;}
}

/* ══ CATEGORIES ══ */
.cat-section{padding:28px 40px 60px;text-align:center;background:#fff;}
.cat-circles{display:grid;grid-template-columns:repeat(8,1fr);gap:24px 20px;max-width:1200px;margin:0 auto;}
.cat-circle{display:flex;flex-direction:column;align-items:center;gap:11px;cursor:pointer;transition:all .38s;}
.cat-circle:hover{transform:translateY(-9px);}
.cat-circle-img{width:90px;height:90px;border-radius:50%;overflow:hidden;border:2px solid rgba(202,185,167,.5);box-shadow:0 8px 28px rgba(67,37,20,.08);transition:all .38s;background:var(--cream);display:flex;align-items:center;justify-content:center;font-size:36px;}
.cat-circle:hover .cat-circle-img{border-color:var(--brown);box-shadow:0 18px 45px rgba(67,37,20,.2);}
.cat-circle-img img{width:100%;height:100%;object-fit:contain;transition:transform .42s;padding:10px;}
.cat-circle:hover .cat-circle-img img{transform:scale(1.13);}
.cat-circle-name{font-size:11px;font-weight:700;color:var(--brown);text-transform:uppercase;letter-spacing:.9px;line-height:1.3;text-align:center;}
@media(max-width:1100px){.cat-circles{grid-template-columns:repeat(6,1fr);}}
@media(max-width:768px){.cat-section{padding:56px 20px 40px;}.cat-circles{grid-template-columns:repeat(4,1fr);gap:18px 14px;}.cat-circle-img{width:72px;height:72px;font-size:28px;}.cat-circle-name{font-size:10px;}}
@media(max-width:480px){.cat-circles{grid-template-columns:repeat(3,1fr);gap:14px 10px;}.cat-circle-img{width:64px;height:64px;}.cat-section{padding:44px 16px 32px;}}

/* ══ BEST SELLERS ══ */
.bestsellers-section{padding:36px 40px 76px;background:var(--cream);}
.bestsellers-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:26px;max-width:1300px;margin:0 auto;}

/* ── NEW PRODUCT CARD (shared by bestsellers + all-products) ── */
.pc2{
  background:#fff;border-radius:16px;overflow:hidden;
  transition:box-shadow .38s,transform .38s;
  box-shadow:0 4px 22px rgba(67,37,20,.07);
  border:1px solid rgba(202,185,167,.22);
  display:flex;flex-direction:column;position:relative;
}
.pc2:hover{transform:translateY(-7px);box-shadow:0 20px 52px rgba(67,37,20,.15);}

/* Badge */
.pc2-badge{
  position:absolute;top:10px;left:10px;
  background:var(--brown);color:#fff;
  font-size:9px;font-weight:700;letter-spacing:.7px;text-transform:uppercase;
  padding:4px 11px;border-radius:20px;z-index:2;
  box-shadow:0 3px 10px rgba(67,37,20,.3);
}

/* Image area */
.pc2-img{
  height:200px;overflow:hidden;background:var(--cream);
  flex-shrink:0;position:relative;
}
.pc2-img img{
  width:100%;height:100%;object-fit:contain;
  padding:12px;transition:transform .5s;
}
.pc2:hover .pc2-img img{transform:scale(1.06);}

/* Safety: hide images on non-Dry-Sharbat cards */
.pc2:not([data-ds]) .pc2-img img{display:none!important;}

/* Image fallback — product name as text */
.pc2-img-fallback{
  display:flex;align-items:center;justify-content:center;
  width:100%;height:100%;
  background:linear-gradient(135deg,#faf6f1,#f0e6d8);
  font-family:"Cormorant Garamond",serif;
  font-size:17px;font-weight:700;color:var(--brown);
  text-align:center;padding:18px;line-height:1.35;
}

/* ── Card body ── */
.pc2-body{padding:12px 14px 14px;flex:1;display:flex;flex-direction:column;}

/* Name — full width, top */
.pc2-name{
  font-size:13px;font-weight:700;color:#1a1a1a;
  line-height:1.4;margin-bottom:6px;
  text-transform:uppercase;letter-spacing:.15px;
}

/* Stars row */
.pc2-stars{display:flex;align-items:center;gap:5px;margin-bottom:10px;}
.pc2-stars-icons{color:#f5a623;font-size:13px;letter-spacing:1px;}
.pc2-reviews{font-size:11px;color:#888;font-weight:500;}

/* Mid row: pills on RIGHT, price on LEFT — side by side */
.pc2-mid{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:8px;
  margin-bottom:12px;
  flex-wrap:wrap;
}

/* Price sits on the left of mid row */
.pc2-price-col{display:flex;flex-direction:column;justify-content:center;gap:2px;}
.pc2-price{
  font-size:20px;font-weight:800;color:var(--brown);
  font-family:"Cormorant Garamond",serif;line-height:1;
}

/* Pills sit on the right of mid row */
.pc2-pills{display:flex;gap:5px;flex-wrap:wrap;justify-content:flex-end;}
.pc2-pill{
  padding:4px 11px;border-radius:20px;
  border:1.5px solid #d0c8c0;
  font-size:11.5px;font-weight:700;color:#555;
  cursor:pointer;background:#fff;
  transition:all .2s;white-space:nowrap;
  font-family:"Cormorant Garamond",sans-serif;
}
.pc2-pill.active{border-color:var(--brown);background:var(--brown);color:#fff;}
.pc2-pill:hover:not(.active){border-color:var(--brown);color:var(--brown);}

/* Variant dropdown (4+ variants) */
.pc2-select-wrap{margin-bottom:10px;}
.pc2-select{
  width:100%;padding:7px 10px;border-radius:10px;
  border:1.5px solid #d9cfc7;font-size:13px;font-weight:600;
  color:#333;background:#fff;cursor:pointer;
  font-family:"Cormorant Garamond",sans-serif;
  outline:none;transition:border-color .2s;
}
.pc2-select:focus{border-color:var(--brown);}

/* ADD TO CART — full width, bottom */
.pc2-cart-btn{
  width:100%;padding:11px;margin-top:auto;
  background:var(--btn-cart-bg);color:#fff;
  border:none;border-radius:10px;
  font-size:13px;font-weight:700;letter-spacing:.5px;
  cursor:pointer;transition:all .28s;
  box-shadow:0 4px 14px rgba(26,107,58,.28);
  font-family:"Cormorant Garamond",sans-serif;
}
.pc2-cart-btn:hover{background:var(--btn-cart-hover);transform:translateY(-2px);box-shadow:0 8px 20px rgba(26,107,58,.42);}
.pc2-cart-btn:disabled{opacity:.5;cursor:not-allowed;transform:none;}

/* QTY COUNTER — replaces ADD TO CART when qty > 0 */
.pc2-qty-wrap{
  width:100%;margin-top:auto;
  display:none; /* hidden by default; shown via JS */
  align-items:center;justify-content:space-between;
  background:var(--btn-cart-bg);
  border-radius:10px;overflow:hidden;
  box-shadow:0 4px 14px rgba(26,107,58,.28);
}
.pc2-qty-wrap.active{display:flex;}
.pc2-qty-btn{
  width:44px;height:44px;flex-shrink:0;
  border:none;background:rgba(0,0,0,.18);color:#fff;
  font-size:20px;font-weight:800;cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  transition:background .2s;
  font-family:"Cormorant Garamond",sans-serif;
  -webkit-tap-highlight-color:transparent;
}
.pc2-qty-btn:hover{background:rgba(0,0,0,.3);}
.pc2-qty-num{
  flex:1;text-align:center;color:#fff;
  font-size:16px;font-weight:800;
  font-family:"Cormorant Garamond",sans-serif;
  user-select:none;
}

/* legacy class kept for compat */
.bs-card{background:#fff;border-radius:16px;overflow:hidden;transition:all .42s;box-shadow:0 4px 22px rgba(67,37,20,.07);position:relative;border:1px solid rgba(202,185,167,.22);display:flex;flex-direction:column;}
@media(max-width:1200px){.bestsellers-grid{grid-template-columns:repeat(2,1fr);}}
@media(max-width:768px){.bestsellers-section{padding:30px 20px 52px;}.bestsellers-grid{grid-template-columns:repeat(2,1fr);gap:16px;}}
@media(max-width:480px){.bestsellers-grid{grid-template-columns:repeat(2,1fr);gap:12px;}.bestsellers-section{padding:28px 16px 46px;}}

/* ══ PROMO BANNER ══ */
@keyframes floatCircle1 {
  0%   { transform: translate(0, 0) scale(1); }
  25%  { transform: translate(-180px, 60px) scale(1.08); }
  50%  { transform: translate(-80px, 130px) scale(0.95); }
  75%  { transform: translate(60px, 40px) scale(1.05); }
  100% { transform: translate(0, 0) scale(1); }
}
@keyframes floatCircle2 {
  0%   { transform: translate(0, 0) scale(1); }
  25%  { transform: translate(120px, -80px) scale(0.92); }
  50%  { transform: translate(200px, 60px) scale(1.1); }
  75%  { transform: translate(60px, 120px) scale(0.96); }
  100% { transform: translate(0, 0) scale(1); }
}
@keyframes floatCircle3 {
  0%   { transform: translate(0, 0) scale(1); }
  33%  { transform: translate(140px, -100px) scale(1.12); }
  66%  { transform: translate(-100px, -60px) scale(0.9); }
  100% { transform: translate(0, 0) scale(1); }
}

.promo-banner{margin:0 40px 76px;background:linear-gradient(120deg,#ff8c00 0%,#ff6b00 40%,#e85d00 100%);border-radius:30px;padding:58px 74px;display:flex;align-items:center;justify-content:space-between;gap:40px;flex-wrap:wrap;position:relative;overflow:hidden;min-height:320px;align-items:flex-start;}
.promo-banner::before {
  content: "";
  position: absolute;
  top: -110px;
  right: -110px;
  width: 400px;
  height: 400px;
  border-radius: 50%;
  background: rgba(255,255,255,.12);
  pointer-events: none;
  animation: floatCircle1 9s ease-in-out infinite;
}
.promo-banner::after {
  content: "";
  position: absolute;
  bottom: -70px;
  left: 320px;
  width: 240px;
  height: 240px;
  border-radius: 50%;
  background: rgba(255,255,255,.10);
  pointer-events: none;
  animation: floatCircle2 7s ease-in-out infinite;
}
.promo-circle3 {
  position: absolute;
  bottom: -120px;
  left: -80px;
  width: 320px;
  height: 320px;
  border-radius: 50%;
  background: rgba(255,255,255,.07);
  pointer-events: none;
  animation: floatCircle3 11s ease-in-out infinite;
}
/* GREEN THEME */
.promo-banner.theme-green {
  background: linear-gradient(120deg,#2e7d32 0%,#43a047 40%,#66bb6a 100%);
}
#promoDesc {
  min-height: 5em;
  max-height: 5em;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
}

/* PINK / ROSE THEME */
.promo-banner.theme-purple {
  background: linear-gradient(120deg,#4a148c 0%,#6a1b9a 40%,#9c27b0 100%);
}
.promo-deco{position:absolute;top:10px;right:42%;font-size:130px;opacity:.06;pointer-events:none;line-height:1;}
.promo-text{position:relative;z-index:2;}
.promo-title{font-family:"Cormorant Garamond",serif;font-size:40px;color:#fff;line-height:1.2;margin-bottom:14px;font-weight:700;min-height:2.5em;max-height: 2.5em;
  overflow: hidden;}
.promo-title em{color:#ffe5b0;font-style:italic;}
.promo-desc{font-size:15px;color:rgba(255,240,210,.92);max-width:430px;line-height:1.8;min-height:3.5em;}
.typewriter-cursor{display:inline-block;width:2px;height:1em;background:#fff;margin-left:3px;vertical-align:middle;animation:blink .7s step-end infinite;}
@keyframes blink{0%,100%{opacity:1;}50%{opacity:0;}}
.promo-flavours{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px;}
.promo-flavour-pill{background:rgba(255,255,255,.18);border:1px solid rgba(255,255,255,.3);color:#fff;font-size:11px;font-weight:600;padding:5px 13px;border-radius:20px;backdrop-filter:blur(4px);}
.promo-cta{position:relative;z-index:2;flex-shrink:0;}
.promo-btn{display:inline-block;padding:16px 46px;background:#fff;color:#c25000;font-size:15px;font-weight:700;border-radius:30px;text-decoration:none;transition:all .3s;border:none;cursor:pointer;box-shadow:0 8px 24px rgba(0,0,0,.18);}
.promo-btn:hover{background:#ffe5b0;transform:translateY(-3px);}
.promo-badge{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.2);border:1px solid rgba(255,255,255,.35);color:#fff;font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;padding:6px 14px;border-radius:20px;margin-bottom:14px;}
@media(max-width:1024px){.promo-banner{margin:0 24px 60px;padding:46px 44px;}.promo-title{font-size:32px;}}
@media(max-width:768px){.promo-banner{margin:0 20px 52px;padding:40px 32px;}.promo-title{font-size:28px;}}
@media(max-width:600px){.promo-banner{margin:0 16px 44px;padding:36px 24px;text-align:center;justify-content:center;}.promo-flavours{justify-content:center;}.promo-deco{display:none;}.promo-title{font-size:24px;}.promo-btn{padding:14px 32px;font-size:14px;}}

/* ══ ALL PRODUCTS ══ */
.all-products-section{padding:36px 40px 96px;background:#fff;}
.products-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:26px;max-width:1300px;margin:0 auto;}
/* Cards use the shared .pc2 class */
@media(max-width:1200px){.products-grid{grid-template-columns:repeat(3,1fr);}}
@media(max-width:900px){.products-grid{grid-template-columns:repeat(2,1fr);}.all-products-section{padding:30px 20px 72px;}}
@media(max-width:480px){.products-grid{grid-template-columns:repeat(2,1fr);gap:12px;}.all-products-section{padding:28px 16px 56px;}}

/* ══ STORY ══ */
.story-section{padding:80px 40px;background:linear-gradient(135deg,#ff0088 0%,#c0106e 40%,#80298b 100%);position:relative;overflow:hidden;}
.story-section::before{content:"";position:absolute;top:-130px;left:-130px;width:430px;height:430px;border-radius:50%;background:rgba(255,255,255,.08);pointer-events:none;z-index:0;}
.story-section::after{content:"";position:absolute;bottom:-110px;right:-110px;width:380px;height:380px;border-radius:50%;background:rgba(255,255,255,.06);pointer-events:none;z-index:0;}
.story-layout{max-width:1200px;margin:0 auto;display:flex;align-items:center;gap:60px;position:relative;z-index:2;}
.story-video-wrap{
  flex:0 0 420px;
  border-radius:24px;
  overflow:hidden;
  position:relative;

  /* VERY LIGHT PURPLE */
  background: linear-gradient(
    135deg,
    rgba(206,39,176,0.06),
    rgba(243,229,245,0.02)
  );

  box-shadow:
    0 28px 72px rgba(0,0,0,.5),
    0 0 0 1.5px rgba(156,39,176,0.15);
}

.story-video-wrap video{
  width:100%;
  display:block;
  object-fit:cover;
  max-height:420px;
}
.story-inner{flex:1;text-align:center;position:relative;z-index:2;}
.story-eyebrow{display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:2.5px;color:rgba(255,220,240,.85);margin-bottom:10px;}
.story-title{font-family:"Cormorant Garamond",serif;font-size:48px;color:#fff;line-height:1.2;margin-bottom:22px;font-weight:700;}
.story-title em{color:#ffd6f0;font-style:italic;}
.story-text{font-size:16px;color:rgba(255,220,240,.88);line-height:1.9;max-width:520px;margin:0 auto 52px;}
.story-stats{display:flex;justify-content:center;gap:40px;flex-wrap:wrap;}
.stat-item{text-align:center;min-width:100px;}
.stat-num{font-family:"Cormorant Garamond",serif;font-size:56px;color:#fff;line-height:1;font-weight:700;display:block;}
.stat-label{font-size:13px;color:rgba(255,220,240,.75);margin-top:8px;display:block;}
@media(max-width:1100px){.story-video-wrap{flex:0 0 320px;}.story-layout{gap:40px;}.story-title{font-size:38px;}.stat-num{font-size:44px;}.story-stats{gap:28px;}}
@media(max-width:768px){.story-section{padding:64px 24px;}.story-layout{flex-direction:column;gap:36px;}.story-video-wrap{flex:none;width:100%;max-width:480px;margin:0 auto;}.story-title{font-size:32px;}.story-text{font-size:14px;max-width:100%;}.stat-num{font-size:38px;}}
@media(max-width:480px){.story-section{padding:52px 20px;}.story-stats{gap:20px;}.stat-num{font-size:30px;}.story-title{font-size:26px;}}

/* ══ BENEFITS ══ */
.benefits-section{background:var(--cream);padding:76px 40px;}
.benefits-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:26px;max-width:1200px;margin:44px auto 0;}
.benefit-card{text-align:center;padding:36px 26px;background:#fff;border-radius:22px;transition:all .38s;border:1px solid rgba(202,185,167,.22);position:relative;overflow:hidden;}
.benefit-card::before{content:"";position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--gold),var(--brown));transform:scaleX(0);transform-origin:left;transition:transform .42s;}
.benefit-card:hover::before{transform:scaleX(1);}
.benefit-card:hover{transform:translateY(-8px);box-shadow:0 20px 54px rgba(67,37,20,.12);}
.benefit-icon{width:68px;height:68px;border-radius:50%;background:rgba(202,185,167,.25);display:flex;align-items:center;justify-content:center;font-size:28px;margin:0 auto 18px;transition:all .38s;}
.benefit-card:hover .benefit-icon{background:var(--brown);transform:scale(1.12);}
.benefit-card h4{color:var(--brown);font-size:15px;font-weight:600;margin-bottom:9px;}
.benefit-card p{font-size:13px;color:#9a8070;line-height:1.7;}
@media(max-width:1024px){.benefits-grid{grid-template-columns:repeat(2,1fr);}}
@media(max-width:768px){.benefits-section{padding:52px 20px;}.benefits-grid{gap:16px;margin-top:32px;}}
@media(max-width:480px){.benefits-grid{grid-template-columns:1fr;gap:14px;}}

/* ══ TESTIMONIALS TABS ══ */
.testi-tab-row{display:flex;align-items:center;justify-content:center;gap:10px;margin:20px 0 32px;}
.testi-tab{display:inline-flex;align-items:center;gap:7px;padding:10px 28px;border-radius:50px;border:2px solid rgba(202,185,167,.5);background:#fff;color:var(--brown);font-family:"Cormorant Garamond",serif;font-size:16px;font-weight:600;cursor:pointer;transition:all .28s;box-shadow:0 2px 10px rgba(67,37,20,.06);}
.testi-tab:hover{border-color:var(--brown);}
.testi-tab.active{background:var(--brown);color:#fff;border-color:var(--brown);box-shadow:0 6px 20px rgba(67,37,20,.25);}
.testi-tab .tab-icon{font-size:17px;}
/* Gallery carousel */
.testi-gallery{display:none;padding:0 0 20px;}
.testi-gallery.active{display:block;}
.gallery-carousel-wrap{position:relative;overflow:hidden;width:100%;padding:10px 0;}
.gallery-carousel-wrap::before,.gallery-carousel-wrap::after{content:"";position:absolute;top:0;bottom:0;width:100px;z-index:10;pointer-events:none;}
.gallery-carousel-wrap::before{left:0;background:linear-gradient(to right,rgba(255,255,255,.9),transparent);}
.gallery-carousel-wrap::after{right:0;background:linear-gradient(to left,rgba(255,255,255,.9),transparent);}
.gallery-track{display:flex;gap:24px;padding:10px 80px;transition:none;will-change:transform;user-select:none;}
.gallery-track.smooth{transition:transform .55s cubic-bezier(.4,0,.2,1);}
.gallery-slide{flex-shrink:0;width:360px;height:320px;border-radius:24px;overflow:hidden;box-shadow:0 8px 32px rgba(67,37,20,.08);border:1px solid rgba(202,185,167,.3);cursor:pointer;transition:transform .4s cubic-bezier(.4,0,.2,1),box-shadow .4s,border-color .4s,opacity .4s;background:#faf6f1;position:relative;display:flex;align-items:center;justify-content:center;}
.gallery-slide img,.gallery-slide video{width:100%;height:100%;object-fit:contain;display:block;border-radius:20px;}
.gallery-slide.center{transform:translateY(-10px) scale(1.025);box-shadow:0 28px 72px rgba(67,37,20,.18);border-color:rgba(202,185,167,.6);}
.gallery-slide.side{opacity:.7;transform:translateY(0) scale(.97);}
.gallery-video-icon{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;}
.gallery-play-btn{width:58px;height:58px;border-radius:50%;background:rgba(67,37,20,.72);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;color:#fff;font-size:22px;padding-left:4px;box-shadow:0 4px 20px rgba(0,0,0,.3);border:2px solid rgba(255,255,255,.4);transition:transform .3s,background .3s;}
.gallery-slide-video:hover .gallery-play-btn{background:var(--brown);transform:scale(1.12);}
.gallery-arrow{position:absolute;top:50%;transform:translateY(-50%);width:44px;height:44px;border-radius:50%;border:2px solid rgba(202,185,167,.5);background:#fff;color:var(--brown);font-size:18px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .3s;box-shadow:0 4px 16px rgba(67,37,20,.1);z-index:20;}
.gallery-arrow:hover{background:var(--brown);color:#fff;border-color:var(--brown);}
.gallery-prev{left:18px;}
.gallery-next{right:18px;}
.gallery-dots-row{display:flex;justify-content:center;margin-top:18px;}
/* Reviews panel */
.testi-reviews-panel{display:none;}
.testi-reviews-panel.active{display:block;}
/* Lightbox */
.gallery-lightbox{position:fixed;inset:0;background:rgba(0,0,0,.88);z-index:99999;display:none;align-items:center;justify-content:center;padding:20px;}
.gallery-lightbox.open{display:flex;}
.gallery-lightbox img,.gallery-lightbox video{max-width:90vw;max-height:88vh;border-radius:14px;object-fit:contain;}
.gallery-lightbox-close{position:absolute;top:20px;right:28px;color:#fff;font-size:36px;cursor:pointer;line-height:1;font-weight:300;transition:opacity .2s;}
.gallery-lightbox-close:hover{opacity:.6;}
@media(max-width:768px){.testi-tab{padding:9px 20px;font-size:14px;}.gallery-slide{width:300px;height:260px;}.gallery-track{padding:10px 40px;}.gallery-carousel-wrap::before,.gallery-carousel-wrap::after{width:50px;}}
@media(max-width:480px){.gallery-slide{width:272px;height:240px;}.gallery-track{padding:10px 24px;}}.testimonials-section{padding:84px 0 100px;background:#fff;overflow:hidden;}
.testimonials-section .section-header{padding:0 40px;}
.testi-track-wrap{position:relative;overflow:hidden;width:100%;padding:30px 0 20px;}
.testi-track-wrap::before,.testi-track-wrap::after{content:"";position:absolute;top:0;bottom:0;width:140px;z-index:10;pointer-events:none;}
.testi-track-wrap::before{left:0;background:linear-gradient(90deg,#fff 40%,transparent);}
.testi-track-wrap::after{right:0;background:linear-gradient(270deg,#fff 40%,transparent);}
.testi-track{display:flex;gap:24px;padding:10px 80px;will-change:transform;user-select:none;transition:none;}
.testi-track.smooth{transition:transform .55s cubic-bezier(.4,0,.2,1);}
.testi-card{flex-shrink:0;width:360px;background:#fff;border-radius:24px;padding:36px 32px;border:1px solid rgba(202,185,167,.3);box-shadow:0 8px 32px rgba(67,37,20,.08);transition:transform .4s cubic-bezier(.4,0,.2,1),box-shadow .4s,border-color .4s,opacity .4s;position:relative;cursor:grab;display:flex;flex-direction:column;}
.testi-card:active{cursor:grabbing;}
.testi-card.center{transform:translateY(-10px) scale(1.025);box-shadow:0 28px 72px rgba(67,37,20,.18);border-color:rgba(202,185,167,.6);}
.testi-card.side{opacity:.7;transform:translateY(0) scale(.97);}
.testi-card::before{content:"\201C";position:absolute;top:20px;right:28px;font-size:72px;color:rgba(201,168,76,.18);font-family:"Cormorant Garamond",serif;line-height:1;pointer-events:none;}
.testi-stars{color:var(--gold);font-size:16px;margin-bottom:16px;letter-spacing:2px;}
.testi-text{font-size:17px;font-weight:700;color:#6b4b35;line-height:1.85;margin-bottom:24px;flex:1;}
.testi-author{display:flex;align-items:center;gap:14px;border-top:1px solid rgba(202,185,167,.3);padding-top:16px;margin-top:auto;}
.testi-avatar{width:48px;height:48px;border-radius:50%;background:linear-gradient(135deg,var(--sand),var(--brown));display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;}
.testi-name{font-size:15px;font-weight:700;color:var(--brown);white-space:nowrap;}
.testi-nav-row{display:flex;align-items:center;justify-content:center;gap:16px;margin-top:28px;}
.testi-arrow{width:44px;height:44px;border-radius:50%;border:2px solid rgba(202,185,167,.5);background:#fff;color:var(--brown);font-size:18px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .3s;box-shadow:0 4px 16px rgba(67,37,20,.1);flex-shrink:0;}
.testi-arrow:hover{background:var(--brown);color:#fff;border-color:var(--brown);transform:scale(1.1);}
.testi-dots{display:flex;gap:8px;}
.testi-dots span{width:8px;height:8px;border-radius:50%;background:rgba(67,37,20,.18);cursor:pointer;transition:all .35s;display:inline-block;}
.testi-dots span.active{background:var(--brown);width:28px;border-radius:4px;}
@media(max-width:768px){.testi-card{width:300px;padding:28px 24px;}.testimonials-section{padding:60px 0 80px;}.testi-track{padding:10px 40px;}.testi-track-wrap::before,.testi-track-wrap::after{width:60px;}}
@media(max-width:480px){.testi-card{width:272px;}.testi-track{padding:10px 24px;}.testimonials-section .section-header{padding:0 20px;}}

/* ══ NEWSLETTER ══ */
/* Pulse glow animation */
@keyframes pulseGlow {
  0% {
    box-shadow: 0 0 0 0 rgba(37,211,102, 0.6);
  }
  70% {
    box-shadow: 0 0 0 18px rgba(37,211,102, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(37,211,102, 0);
  }
}

/* Shine effect */
.whatsapp-subscribe button::before{
  content:"";
  position:absolute;
  top:0;
  left:-100%;
  width:100%;
  height:100%;
  background:linear-gradient(120deg,transparent,rgba(255,255,255,0.4),transparent);
  transition:all .6s;
}

/* Apply animation */
.whatsapp-subscribe button{
  position:relative;
  overflow:hidden;
  animation:pulseGlow 2.5s infinite;
}

/* Shine on hover */
.whatsapp-subscribe button:hover::before{
  left:100%;
}
.whatsapp-subscribe{
  display:flex;
  justify-content:center;
  margin-top:10px;
}

.whatsapp-subscribe button{
  padding:18px 40px;
  border-radius:40px;
  background:linear-gradient(135deg,#25d366,#128c7e);
  color:#fff;
  border:none;
  font-size:16px;
  font-weight:700;
  cursor:pointer;
  transition:all .3s;
  box-shadow:0 8px 24px rgba(37,211,102,.35);
}

.whatsapp-subscribe button:hover{
  transform:translateY(-3px) scale(1.03);
  box-shadow:0 12px 32px rgba(37,211,102,.5);
}
.newsletter-section{padding:84px 40px;background:var(--cream);text-align:center;}
.newsletter-inner{max-width:540px;margin:0 auto;}
.newsletter-inner p{font-size:15px;color:#7a6a5c;margin-bottom:32px;line-height:1.75;}
.newsletter-form{display:flex;gap:12px;max-width:470px;margin:0 auto;}
.newsletter-form input{flex:1;padding:15px 22px;border-radius:30px;border:1.5px solid rgba(202,185,167,.5);font-family:"Cormorant Garamond",sans-serif;font-size:14px;background:#fff;outline:none;color:#333;transition:border-color .3s;}
.newsletter-form input:focus{border-color:var(--brown);}
.newsletter-form button{padding:15px 30px;border-radius:30px;background:var(--btn-cart-bg);color:#fff;border:none;font-size:14px;font-weight:600;cursor:pointer;transition:all .3s;font-family:"Cormorant Garamond",sans-serif;white-space:nowrap;box-shadow:0 4px 14px rgba(26,107,58,.35);}
.newsletter-form button:hover{background:var(--btn-cart-hover);transform:translateY(-2px);}
@media(max-width:600px){.newsletter-form{flex-direction:column;}.newsletter-section{padding:60px 20px;}.newsletter-form input,.newsletter-form button{width:100%;}}

/* ══ FOOTER ══ */
/* base */
.footer-contact-item{
  transition: all .35s cubic-bezier(.4,0,.2,1);
  border-radius: 14px;
  padding: 10px;
  cursor: pointer;
}

/* hover effect */
.footer-contact-item:hover{
  background: rgba(201,168,76,.12);
  transform: translateX(8px) scale(1.02);
  box-shadow: 0 8px 24px rgba(201,168,76,.15);
}

/* icon animation */
.footer-contact-icon{
  transition: all .35s ease;
}

.footer-contact-item:hover .footer-contact-icon{
  transform: rotate(-6deg) scale(1.15);
  background: var(--gold);
  color: #000;
}

/* text highlight */
.footer-contact-item:hover .footer-contact-text{
  color: #fff;
}
.gamtu-footer{background:linear-gradient(160deg,#1a0c05 0%,#2e1408 50%,#1a0c05 100%);color:var(--sand);position:relative;overflow:hidden;}
.footer-top-bar{background:linear-gradient(90deg,rgba(201,168,76,.15),rgba(201,168,76,.05),rgba(201,168,76,.15));border-bottom:1px solid rgba(201,168,76,.2);padding:20px 60px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;}
.footer-top-tagline{font-size:14px;color:rgba(202,185,167,.75);letter-spacing:.5px;}
.footer-top-tagline strong{color:var(--gold2);}
.footer-trust-badges{display:flex;gap:24px;align-items:center;flex-wrap:wrap;}
.trust-badge{display:flex;align-items:center;gap:7px;font-size:12px;font-weight:600;color:rgba(202,185,167,.7);letter-spacing:.3px;}
.trust-badge-icon{width:28px;height:28px;border-radius:50%;background:rgba(201,168,76,.12);border:1px solid rgba(201,168,76,.25);display:flex;align-items:center;justify-content:center;font-size:13px;}
.footer-main{padding:64px 60px 48px;display:grid;grid-template-columns:1.8fr 1fr 1fr 1.2fr;gap:56px;max-width:1400px;margin:0 auto;}
.footer-logo-wrap{margin-bottom:10px;margin-left:-25px;}
.footer-logo-wrap img{height:100px;display:block;}
.footer-brand-desc{font-size:15px;line-height:1.9;color:rgba(202,185,167,.7);margin-bottom:28px;max-width:370px;}
.footer-social{display:flex;gap:10px;flex-wrap:wrap;}
.social-btn{width:44px;height:44px;border-radius:14px;background:rgba(255,255,255,.05);border:1px solid rgba(202,185,167,.15);display:flex;align-items:center;justify-content:center;font-size:17px;color:rgba(202,185,167,.7);transition:all .35s;text-decoration:none;}
.social-btn:hover{transform:translateY(-4px);border-color:rgba(201,168,76,.5);background:rgba(201,168,76,.12);}
.social-btn:hover .fa-instagram{color:#e1306c;}
.social-btn:hover .fa-whatsapp{color:#25d366;}
.social-btn:hover .fa-facebook-f{color:#1877f2;}
.social-btn:hover .fa-envelope{color:#ea4335;}
.social-btn:hover .fa-youtube{color:#ff0000;}
.footer-col h4{color:#fff;font-size:13px;font-weight:700;margin-bottom:22px;text-transform:uppercase;letter-spacing:2px;display:flex;align-items:center;gap:10px;}
.footer-col h4::after{content:"";flex:1;height:1px;background:rgba(201,168,76,.2);}
.footer-links{display:flex;flex-direction:column;gap:10px;}
.footer-links a{color:rgba(202,185,167,.65);text-decoration:none;font-size:14px;transition:all .25s;display:flex;align-items:center;gap:8px;padding:4px 0;}
.footer-links a::before{content:"→";font-size:11px;opacity:0;transform:translateX(-6px);transition:all .25s;}
.footer-links a:hover{color:#fff;padding-left:4px;}
.footer-links a:hover::before{opacity:.6;transform:translateX(0);}
.footer-contact-item{display:flex;align-items:flex-start;gap:12px;margin-bottom:16px;}
.footer-contact-icon{width:36px;height:36px;border-radius:10px;background:rgba(201,168,76,.1);border:1px solid rgba(201,168,76,.2);display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;}
.footer-contact-text{font-size:14px;color:rgba(202,185,167,.75);line-height:1.5;padding-top:6px;}
.footer-contact-text strong{display:block;color:#fff;font-size:12px;font-weight:700;margin-bottom:2px;letter-spacing:.5px;}
.footer-divider{height:1px;background:linear-gradient(90deg,transparent,rgba(201,168,76,.35),rgba(201,168,76,.5),rgba(201,168,76,.35),transparent);margin:0 60px;}
.footer-bottom{padding:24px 60px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px;}
.footer-bottom-copy{font-size:13px;color:rgba(202,185,167,.45);}
.footer-bottom-copy span{color:rgba(201,168,76,.7);}
.footer-bottom-links{display:flex;gap:22px;flex-wrap:wrap;}
.footer-bottom-links a{font-size:12.5px;color:rgba(202,185,167,.4);text-decoration:none;transition:color .25s;}
.footer-bottom-links a:hover{color:rgba(202,185,167,.8);}
.footer-deco{position:absolute;right:-80px;top:-80px;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(201,168,76,.06),transparent 70%);pointer-events:none;}
.footer-deco2{position:absolute;left:-60px;bottom:-60px;width:300px;height:300px;border-radius:50%;background:radial-gradient(circle,rgba(201,168,76,.05),transparent 70%);pointer-events:none;}
@media(max-width:1200px){.footer-main{grid-template-columns:1fr 1fr;gap:40px;padding:52px 40px 40px;}.footer-top-bar{padding:18px 40px;}}
@media(max-width:768px){.footer-main{grid-template-columns:1fr 1fr;gap:32px;padding:40px 24px 32px;}.footer-top-bar{padding:14px 24px;}.footer-divider{margin:0 24px;}.footer-bottom{padding:20px 24px;flex-direction:column;text-align:center;}}
@media(max-width:520px){.footer-main{grid-template-columns:1fr;gap:28px;padding:36px 20px 28px;}.footer-top-bar{flex-direction:column;gap:12px;text-align:center;}.footer-trust-badges{justify-content:center;}.footer-bottom-links{justify-content:center;}.footer-divider{margin:0 20px;}.footer-bottom{padding:16px 20px;}}
.credit{
  color: rgba(202,185,167,.5);
  font-size: 12px;
  margin-left: 6px;
  transition: all .3s;
}

.credit:hover{
  color: var(--gold);
  cursor: pointer;
}
/* ══ CART TOAST ══ */
.cart-toast{position:fixed;bottom:30px;right:30px;z-index:99999;display:flex;align-items:center;gap:14px;background:#fff;border-radius:18px;padding:16px 22px 16px 18px;box-shadow:0 20px 60px rgba(67,37,20,.22),0 4px 16px rgba(0,0,0,.08);border-left:5px solid var(--brown);min-width:300px;max-width:380px;transform:translateX(140%) scale(.92);opacity:0;transition:all .42s cubic-bezier(.34,1.56,.64,1);pointer-events:none;}
.cart-toast.show{transform:translateX(0) scale(1);opacity:1;pointer-events:auto;}
.cart-toast-img{width:56px;height:56px;border-radius:12px;object-fit:contain;flex-shrink:0;background:var(--cream);padding:4px;}
.cart-toast-img-placeholder{width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,var(--sand),#e8ddd3);display:flex;align-items:center;justify-content:center;font-size:26px;flex-shrink:0;}
.cart-toast-body{flex:1;min-width:0;}
.cart-toast-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.8px;color:#22c55e;margin-bottom:3px;display:flex;align-items:center;gap:5px;}
.cart-toast-label::before{content:"";width:6px;height:6px;border-radius:50%;background:#22c55e;display:inline-block;}
.cart-toast-name{font-size:15px;font-weight:700;color:var(--brown);margin-bottom:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.cart-toast-price{font-size:13px;color:#7a6a5c;font-weight:500;}
.cart-toast-go{background:var(--btn-cart-bg);color:#fff;border:none;padding:9px 16px;border-radius:10px;font-size:13px;font-weight:700;font-family:"Cormorant Garamond",sans-serif;cursor:pointer;transition:.2s;flex-shrink:0;box-shadow:0 3px 10px rgba(26,107,58,.3);}
.cart-toast-go:hover{background:var(--btn-cart-hover);}
@media(max-width:500px){.cart-toast{bottom:16px;right:10px;left:10px;min-width:unset;max-width:unset;}}
</style>
</head>
