<script>
/* ══════════════════════════════════════════
   INTRO VIDEO SPLASH LOGIC
   - Shows full screen on first visit (per session)
   - Auto-dismisses after 10 seconds with fade
   - Skip button with live countdown
   - Sound toggle (starts muted, user can unmute)
══════════════════════════════════════════ */
const _isMob = window.innerWidth <= 768;
if(!sessionStorage.getItem('gamtu_intro_shown')){
  document.getElementById('introVideo').src = _isMob
    ? 'https://gamtuindia.com/wp-content/uploads/2026/05/mobgam.webm'
    : 'https://gamtuindia.com/wp-content/uploads/2026/06/gammf.webm';
}
(function(){
  const overlay   = document.getElementById('introOverlay');
  const video     = document.getElementById('introVideo');
  const prog      = document.getElementById('introProgress');
   video.addEventListener('playing', () => {
  setTimeout(() => {
    document.querySelector('.nav-logo img').style.opacity = '1';
    document.querySelector('.nav-logo img').style.transform = 'scale(1)';
  }, 2800);
}, { once: true });

  let dismissed = false;
  let dismissTimer = null;

  function dismissIntro(){
    if(dismissed) return;
    dismissed = true;
    clearTimeout(dismissTimer);

    window.removeEventListener('wheel',   onWheel);
    window.removeEventListener('keydown', onKey);
    document.removeEventListener('touchstart', onTouchStart);
    document.removeEventListener('touchend',   onTouchEnd);

    document.body.classList.remove('intro-active');
    document.body.style.overflow        = '';
    document.documentElement.style.overflow = '';

    video.style.transition = 'opacity 1.6s ease';
    video.style.opacity    = '0';

    overlay.style.transition    = 'opacity 1.6s ease, visibility 1.6s ease';
    overlay.style.opacity       = '0';
    overlay.style.visibility    = 'hidden';
    overlay.style.pointerEvents = 'none';

    setTimeout(()=>{
      video.pause();
      video.src            = '';
      overlay.style.display = 'none';
      window.dispatchEvent(new Event('resize'));
      window.dispatchEvent(new Event('scroll'));
    }, 1700);
  }

  if(sessionStorage.getItem('gamtu_intro_shown')){
    overlay.style.display = 'none';
    document.body.classList.remove('intro-active');
    document.body.style.overflow        = '';
    document.documentElement.style.overflow = '';
    return;
  }
  sessionStorage.setItem('gamtu_intro_shown','1');

  document.documentElement.style.overflow = 'hidden';
overlay.style.background = 'transparent';

  requestAnimationFrame(()=>{
    requestAnimationFrame(()=>{ prog.classList.add('run'); });
  });

  dismissTimer = setTimeout(dismissIntro, 5000);

  function onWheel(e){ if(Math.abs(e.deltaY) > 3) dismissIntro(); }
  function onKey(e){ if([32,33,34,38,40].includes(e.keyCode)) dismissIntro(); }

  let _ty = 0;
  function onTouchStart(e){ _ty = e.touches[0].clientY; }
  function onTouchEnd(e){
    if(_ty - e.changedTouches[0].clientY > 25) dismissIntro();
  }

  window.addEventListener('wheel',        onWheel,      { passive:true });
  window.addEventListener('keydown',      onKey);
  document.addEventListener('touchstart', onTouchStart, { passive:true });
  document.addEventListener('touchend',   onTouchEnd,   { passive:true });

  window.dismissIntro = dismissIntro;

  video.play().catch(()=>{
    video.muted = true;
    video.play().catch(()=>{});
  });
})();
/* ── CATEGORIES ── */
function sid(n){return n.replace(/[^a-z0-9]/gi,"-").toLowerCase();}
function getCatUrl(cat){return cat ? "product.html#sec-"+sid(cat) : "product.html";}

const CATEGORIES=[
    {name:"Instant Jain Soup",cat:"Instant Jain Soup",emoji:"🍲"},
  {name:"Dry Sharbat",cat:"Dry Sharbat",emoji:"🍹"},
  {name:"Liquid Sharbat",cat:"Liquid Sharbat",emoji:"🥤"},
  {name:"Vegetable Powder",cat:"Vegetable Powder",emoji:"🥬"},
  {name:"Food Masala",cat:"Food Masala",emoji:"🌶️"},
  {name:"Ark",cat:"Ark",emoji:"🧪"},
  {name:"Kansa Products",cat:"Kansa Products",emoji:"🏺"},
  {name:"Most Popular Products",cat:"Most Popular Products",emoji:"⭐"},
];
document.getElementById("catCircles").innerHTML=CATEGORIES.map((c,i)=>`
  <div class="cat-circle reveal" style="transition-delay:${(i%8)*.04}s" onclick="window.location.href='${getCatUrl(c.cat)}'">
    <div class="cat-circle-img">${c.emoji}</div>
    <div class="cat-circle-name">${c.name}</div>
  </div>`).join("");

/* ── AUTH ── */
(function(){
  const u=JSON.parse(localStorage.getItem("user"));
  if(u){
    document.getElementById("profileName").textContent=u.name||"User";
    document.getElementById("profileWrap").style.display="flex";
    document.getElementById("loginLink").style.display="none";
    document.getElementById("mobLoginLink").style.display="none";
  } else {
    document.getElementById("profileWrap").style.display="none";
    document.getElementById("loginLink").style.display="";
    document.getElementById("mobLoginLink").style.display="";
  }
  document.getElementById("logoutBtn").addEventListener("click",e=>{e.preventDefault();localStorage.removeItem("user");window.location.href="sign-up.html";});
})();

/* ── NAVBAR ── */
const mainNav=document.getElementById("mainNav");
window.addEventListener("scroll",()=>mainNav.classList.toggle("scrolled",window.scrollY>40));

const profileWrap=document.getElementById("profileWrap");
const profileBtn=document.getElementById("profileBtn");
if(profileBtn){
  profileBtn.addEventListener("click",e=>{e.stopPropagation();profileWrap.classList.toggle("open");});
  document.addEventListener("click",e=>{if(!profileWrap.contains(e.target))profileWrap.classList.remove("open");});
}
const hamburger=document.getElementById("hamburger");
const mobMenu=document.getElementById("mobMenu");
hamburger.addEventListener("click",e=>{e.stopPropagation();hamburger.classList.toggle("open");mobMenu.classList.toggle("open");});
document.addEventListener("click",e=>{if(!mobMenu.contains(e.target)&&!hamburger.contains(e.target)){hamburger.classList.remove("open");mobMenu.classList.remove("open");}});

/* ── REVEAL ── */
const obs=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting)e.target.classList.add("visible");}),{threshold:.1});
function observeReveal(){document.querySelectorAll(".reveal:not(.observed)").forEach(el=>{el.classList.add("observed");obs.observe(el);});}
observeReveal();

/* ── PROMO TYPEWRITER ── */
const PROMO_DATA=[
  {title:"Dry Sharbat,<br>Made with Khari Sakkar Only",desc:"14 authentic sharbat flavors made with natural khari sakkar, no refined sugar, no artificial colors."},
  {title:"Traditional Taste,<br>Instant Refreshment",desc:"No preservatives, no artificial colours. Just real, organic Indian ingredients blended in water for the most refreshing, Jain-friendly drink you’ve ever tasted."},
  {title:"From Nature,<br>To Your Glass",desc:"100% organic & Jain sharbat blends"},
];
let promoAnimating=false,promoTimeout=null,promoIndex=0;
function typewriterHTML(el,str,sp,cb){
  el.innerHTML="";
  const plain=str.replace(/<br\s*\/?>/gi,"\n").replace(/<[^>]+>/g,"");
  let i=0;
  const cur=document.createElement("span");cur.className="typewriter-cursor";el.appendChild(cur);
  function tick(){if(i<plain.length){const ch=plain[i];if(ch==="\n")cur.before(document.createElement("br"));else cur.before(document.createTextNode(ch));i++;promoTimeout=setTimeout(tick,sp);}else{cur.remove();if(cb)cb();}}
  tick();
}
const banner = document.getElementById("promoBanner");
const themes = ["", "theme-green", "theme-purple"]; 
// 0 = orange (default), 1 = green, 2 = pink

function typewriterText(el, txt, sp, cb){
  el.textContent="";
  let i=0;

  const cur=document.createElement("span");
  cur.className="typewriter-cursor";
  el.appendChild(cur);

  function tick(){
    if(i<txt.length){
      cur.before(document.createTextNode(txt[i]));
      i++;
      promoTimeout=setTimeout(tick,sp);
    }else{
      cur.remove();
      if(cb) cb();
    }
  }
  tick();
}

function runPromo(){
  if(promoAnimating) return;
  promoAnimating = true;

  clearTimeout(promoTimeout);

  const currentIndex = promoIndex % PROMO_DATA.length;
  const d = PROMO_DATA[currentIndex];
  promoIndex++;

  const t = document.getElementById("promoTitle");
  const de = document.getElementById("promoDesc");

  /* 🔥 THEME SWITCH (THIS IS THE MAIN ADDITION) */
  banner.classList.remove("theme-green", "theme-purple");
  if(themes[currentIndex]){
    banner.classList.add(themes[currentIndex]);
  }

  t.innerHTML="";
  de.textContent="";

  typewriterHTML(t, d.title, 38, () => {
    promoTimeout = setTimeout(() => {
      typewriterText(de, d.desc, 18, () => {
        promoAnimating = false;
      });
    }, 200);
  });
}
const promoObs=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting){promoAnimating=false;clearTimeout(promoTimeout);runPromo();}});},{threshold:.4});
promoObs.observe(document.getElementById("promoBanner"));

/* ── COUNTERS ── */
const cntObs=new IntersectionObserver(entries=>{
  entries.forEach(e=>{
    if(e.isIntersecting&&!e.target.dataset.counted){
      e.target.dataset.counted="1";
      const tgt=parseInt(e.target.dataset.target),disp=e.target.dataset.display,suf=e.target.dataset.suffix||"",dur=1800,st=Date.now();
      function tick(){const el=Date.now()-st,pr=Math.min(el/dur,1),ease=1-Math.pow(1-pr,3),val=Math.round(tgt*ease);
        if(tgt===10000)e.target.textContent=val>=10000?"10K+":val>=1000?(val/1000).toFixed(1)+"K":val+suf;
        else e.target.textContent=val+suf;
        if(pr<1)requestAnimationFrame(tick);else e.target.textContent=disp;
      }
      tick();
    }
  });
},{threshold:.3});
document.querySelectorAll(".counter").forEach(el=>cntObs.observe(el));

/* ── INGREDIENT BAR ── */
const ING_C=["#D85A30","#1D9E75","#378ADD","#D4537E","#7F77DD","#BA7517","#639922","#E24B4A","#2D9FA0","#C06C3A"];
function buildIngredientBar(ings){
  if(!ings||!ings.length)return"";
  const segs=ings.map((g,i)=>{const r=i===0?"6px 0 0 6px":i===ings.length-1?"0 6px 6px 6px":"0";return`<div style="flex:${g.percentage};height:100%;background:${ING_C[i%ING_C.length]};border-radius:${r};" title="${g.name}:${g.percentage}%"></div>`;}).join("");
  const pills=ings.map((g,i)=>`<div style="display:flex;align-items:center;gap:5px;font-size:11px;color:#555;padding:3px 9px;background:#faf8f5;border-radius:20px;border:1px solid #e8e0d8;"><div style="width:8px;height:8px;border-radius:50%;background:${ING_C[i%ING_C.length]};flex-shrink:0;"></div><span style="font-weight:500;">${g.name}</span><span style="font-weight:700;color:#432514;">${g.percentage}%</span></div>`).join("");
  return`<div style="margin-top:12px;padding-top:10px;border-top:1px solid #f0e8e0;"><div style="font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.8px;color:#a08060;margin-bottom:7px;">Composition</div><div style="display:flex;height:10px;border-radius:8px;overflow:hidden;gap:2px;margin-bottom:8px;">${segs}</div><div style="display:flex;flex-wrap:wrap;gap:5px;justify-content:center;">${pills}</div></div>`;
}

const SLIDE_BG=["slide-bg-1","slide-bg-2","slide-bg-3","slide-bg-4","slide-bg-5"];
const SLIDE_TAGS=["⭐ Best Seller","🌿 Pure & Natural","🐄 Traditional","🍃 Organic","🙏 Wellness"];

/* ── FETCH PRODUCTS ── */
/* Group same-name products as variants on one card */
function groupProducts(products){
  const map=new Map();
  products.forEach(p=>{
    const key=p.name.trim();
    if(!map.has(key)){
      map.set(key,{...p, variants:[]});
    }
    map.get(key).variants.push({
      label:`${p.grams}${p.unit||'g'}`,
      price:parseFloat(p.price),
      grams:p.grams,
      unit:p.unit||'g',
      stock:p.stock,
      image:p.image||''
    });
  });
  /* For each grouped product: use lowest-price variant as base price,
     pick first variant that has an image */
  const out=[];
  map.forEach(p=>{
    p.variants.sort((a,b)=>a.price-b.price);
    p.price=p.variants[0].price;
    p.grams=p.variants[0].grams;
    p.unit=p.variants[0].unit;
    const imgVariant=p.variants.find(v=>v.image)||p.variants[0];
    p.image=imgVariant.image||'';
    out.push(p);
  });
  return out;
}

fetch("https://api.totalkaro.com/api/public/products/6")
  .then(r=>r.json())
  .then(raw=>{
    const products=groupProducts(raw);
    buildCarousel(raw); /* carousel uses raw for category matching */
    buildBestsellers(products);
    buildAllProducts(products);
    loadAllQty();
  });

/* ── CAROUSEL ── */
function buildCarousel(products){
  const track=document.getElementById("carouselTrack"),dots=document.getElementById("carouselDots");
  track.innerHTML="";dots.innerHTML="";
  // Slide 1: Instant Jain Soup, Slide 2: Coffee, Slide 3: Instant Premix Sauce, then next 2 from list
  const soup=products.find(p=>p.category==='Instant Jain Soup')
           ||products.find(p=>p.category&&p.category.toLowerCase().includes('soup'))
           ||products.find(p=>p.name&&p.name.toLowerCase().includes('soup'));
  const coffee=products.find(p=>p.name==='Coffee (without chicory)')
              ||products.find(p=>p.category&&p.category.toLowerCase().includes('coffee'))
              ||products.find(p=>p.name&&p.name.toLowerCase().includes('coffee'));
  const premix=products.find(p=>p.category==='Instant Premix Sauce')
              ||products.find(p=>p.category&&p.category.toLowerCase().includes('premix'))
              ||products.find(p=>p.category&&p.category.toLowerCase().includes('sauce'));
  // Debug: log what was found
  console.log('Soup:',soup?.name,'|','Coffee:',coffee?.name,'|','Premix:',premix?.name);
  console.log('All categories:',[...new Set(products.map(p=>p.category))]);
  const picked=[soup,coffee,premix].filter(Boolean);
  const usedIds=new Set(picked.map(p=>p.id||p.name));
  const rest=products.filter(p=>!usedIds.has(p.id||p.name)).slice(0,5-picked.length);
  const carouselProducts=[...picked,...rest].slice(0,5);
  carouselProducts.forEach((p,i)=>{
    const img=p.image||"";
    const catUrl=getCatUrl(p.category);
    const div=document.createElement("div");
    div.className=`carousel-slide ${SLIDE_BG[i%SLIDE_BG.length]}`;
    if(i===0)div.classList.add("is-active");
    div.innerHTML=`
      <div class="slide-content">
        <div class="slide-tag">${SLIDE_TAGS[i%SLIDE_TAGS.length]}</div>
        <h2>${p.name}</h2>
        <div class="slide-price">₹ ${p.price} <span>/ ${p.grams||0} ${p.unit||'g'}</span></div>
        <div class="slide-btns">
          <button class="slide-btn-primary" onclick="handleBuy('${p.name}',${p.price},'${img}',${p.grams||0})">Add to Cart</button>
          <button class="slide-btn-secondary" onclick="window.location.href='${catUrl}'">View Details</button>
        </div>
      </div>
     `;
    track.appendChild(div);
    const dot=document.createElement("span");
    if(i===0)dot.classList.add("active");
    dot.addEventListener("click",()=>window.goSlide(i));
    dots.appendChild(dot);
  });
  initCarousel(carouselProducts.slice(0,5).length);
}

function initCarousel(total){
  let idx=0,autoTimer=null;
  const track=document.getElementById("carouselTrack");
  const allDots=()=>document.querySelectorAll("#carouselDots span");
  const allSlides=()=>document.querySelectorAll(".carousel-slide");
  const prog=document.getElementById("carouselProgress");
  function goSlide(n){
    allSlides().forEach(s=>s.classList.remove("is-active"));
    idx=(n+total)%total;
    track.style.transform=`translateX(-${idx*100}%)`;
    allDots().forEach((d,i)=>d.classList.toggle("active",i===idx));
    allSlides()[idx].classList.add("is-active");
    prog.className="carousel-progress";
    void prog.offsetWidth;
    prog.classList.add("run");
  }
  window.goSlide=goSlide;
  function startAuto(){clearInterval(autoTimer);autoTimer=setInterval(()=>goSlide(idx+1),4500);}
  function stopAuto(){clearInterval(autoTimer);}
  document.getElementById("carouselNext").onclick=()=>{goSlide(idx+1);stopAuto();startAuto();};
  document.getElementById("carouselPrev").onclick=()=>{goSlide(idx-1);stopAuto();startAuto();};
  let startX=0;
  track.addEventListener("touchstart",e=>{startX=e.touches[0].clientX;},{passive:true});
  track.addEventListener("touchend",e=>{const dx=e.changedTouches[0].clientX-startX;if(Math.abs(dx)>50){dx<0?goSlide(idx+1):goSlide(idx-1);stopAuto();startAuto();}});
  track.addEventListener("mouseenter",stopAuto);
  track.addEventListener("mouseleave",startAuto);
  goSlide(0);
  startAuto();
}

function getSafeId(n){return n.replace(/\s+/g,"-").toLowerCase();}

/* ── SHARED CARD BUILDER ── */
/* Rating data per product name (stars out of 5, review count) */
const RATINGS={
  'Kokam Dry Sharbat':{stars:4.8,count:124},'Lemonade Dry Sharbat':{stars:4.7,count:98},
  'Coconut Dry Sharbat':{stars:4.9,count:211},'Kalakhatta Dry Sharbat':{stars:4.6,count:76},
};
function getRating(name){
  if(RATINGS[name])return RATINGS[name];
  /* deterministic pseudo-random from name length so same product always gets same rating */
  const base=4.3+(name.length%5)*0.1;
  const cnt=30+(name.charCodeAt(0)%8)*17;
  return{stars:+base.toFixed(1),count:cnt};
}
function starsHtml(stars){
  const full=Math.floor(stars),hasHalf=stars-full>=0.4;
  let h='';
  for(let i=0;i<full;i++)h+='★';
  if(hasHalf)h+='★'; // show as filled for visual cleanliness
  for(let i=full+(hasHalf?1:0);i<5;i++)h+='☆';
  return h;
}
/* Build a single pc2 card. variants = [{label, price, grams}]  */
function buildCard(p, badge, delay){
  const safeId=getSafeId(p.name);
  const rat=getRating(p.name);

  /* Real variants from groupProducts() */
  const variants=(p.variants&&p.variants.length)
    ? p.variants.map(v=>({label:`${v.grams}${v.unit||'g'}`,price:parseFloat(v.price),grams:v.grams,image:v.image||''}))
    : [{label:`${p.grams||0}${p.unit||'g'}`,price:parseFloat(p.price),grams:p.grams||0,image:p.image||''}];

  const firstPrice=variants[0].price;

  /* Build pills HTML (used inside .pc2-mid) */
  let pillsHtml='';
  let dropdownHtml='';
  if(variants.length===1){
    pillsHtml=`<span class="pc2-pill active">${variants[0].label}</span>`;
  } else if(variants.length<=4){
    pillsHtml=variants.map((v,vi)=>
      `<button class="pc2-pill${vi===0?' active':''}" data-card="${safeId}" data-vi="${vi}" onclick="selectVariant('${safeId}',${vi})">${v.label}</button>`
    ).join('');
  } else {
    dropdownHtml=`<div class="pc2-select-wrap"><select class="pc2-select" id="sel-${safeId}" onchange="selectVariantDrop('${safeId}',this.value)">${
      variants.map((v,vi)=>`<option value="${vi}">${v.label} — ₹${v.price}</option>`).join('')
    }</select></div>`;
  }

  /* Image — only Dry Sharbat shows image, all others show product name text */
  const isDrySharbat=(p.category||'').trim()==='Dry Sharbat';
  const img=p.image||'';
  const imgHtml=isDrySharbat && img
    ? `<img src="${img}" alt="${p.name}" loading="lazy"
        onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
       <div class="pc2-img-fallback" style="display:none;">${p.name}</div>`
    : `<div class="pc2-img-fallback">${p.name}</div>`;

  return `<div class="pc2 reveal"${isDrySharbat?' data-ds="1"':''} style="transition-delay:${delay}s" id="card-${safeId}">
    ${badge?`<div class="pc2-badge">${badge}</div>`:''}
    <div class="pc2-img">${imgHtml}</div>
    <div class="pc2-body">
      <div class="pc2-name">${p.name}</div>
      <div class="pc2-stars">
        <span class="pc2-stars-icons">${starsHtml(rat.stars)}</span>
        <span class="pc2-reviews">(${rat.count})</span>
      </div>
      ${dropdownHtml}
      <div class="pc2-mid">
        <div class="pc2-price-col"><span class="pc2-price" id="price-${safeId}">₹${firstPrice}</span></div>
        ${pillsHtml?`<div class="pc2-pills">${pillsHtml}</div>`:''}
      </div>
      <button class="pc2-cart-btn" id="cartbtn-${safeId}"
        onclick="addVariantToCart('${safeId}','${p.name}')">
        ADD TO CART
      </button>
      <div class="pc2-qty-wrap" id="qtywrap-${safeId}">
        <button class="pc2-qty-btn" onclick="pcDec('${safeId}','${p.name}')">−</button>
        <span class="pc2-qty-num" id="qtynum-${safeId}">1</span>
        <button class="pc2-qty-btn" onclick="pcInc('${safeId}','${p.name}')">+</button>
      </div>
    </div>
  </div>`;
}

/* Variant data store — keyed by safeId */
const VARIANT_STORE={};
function registerVariants(p){
  const safeId=getSafeId(p.name);
  /* p.variants is already built by groupProducts() */
  const variants=(p.variants&&p.variants.length)
    ? p.variants.map(v=>({
        label:`${v.grams}${v.unit||'g'}`,
        price:parseFloat(v.price),
        grams:v.grams,
        image:v.image||p.image||''
      }))
    : [{label:`${p.grams||0}${p.unit||'g'}`,price:parseFloat(p.price),grams:p.grams||0,image:p.image||''}];
  VARIANT_STORE[safeId]={variants,selectedIndex:0};
}
function selectVariant(safeId,vi){
  if(!VARIANT_STORE[safeId])return;
  VARIANT_STORE[safeId].selectedIndex=vi;
  const v=VARIANT_STORE[safeId].variants[vi];
  /* update price */
  const priceEl=document.getElementById('price-'+safeId);
  if(priceEl)priceEl.textContent='₹'+v.price;
  /* toggle pills */
  document.querySelectorAll(`[data-card="${safeId}"]`).forEach((el,i)=>{
    el.classList.toggle('active',i===vi);
  });
}
function selectVariantDrop(safeId,vi){
  selectVariant(safeId,parseInt(vi));
}
function addVariantToCart(safeId,name){
  const store=VARIANT_STORE[safeId];
  const v=store?store.variants[store.selectedIndex||0]:{price:0,grams:0,image:''};
  increaseQty(name,v.price,v.image,v.grams);
  _syncCardQty(safeId,name);
}
function pcInc(safeId,name){
  const store=VARIANT_STORE[safeId];
  const v=store?store.variants[store.selectedIndex||0]:{price:0,grams:0,image:''};
  increaseQty(name,v.price,v.image,v.grams);
  _syncCardQty(safeId,name);
}
function pcDec(safeId,name){
  decreaseQty(name);
  _syncCardQty(safeId,name);
}
function _syncCardQty(safeId,name){
  const cart=JSON.parse(localStorage.getItem('cart'))||{};
  const qty=cart[name]?.qty||0;
  const btn=document.getElementById('cartbtn-'+safeId);
  const wrap=document.getElementById('qtywrap-'+safeId);
  const num=document.getElementById('qtynum-'+safeId);
  if(!btn||!wrap)return;
  if(qty>0){
    btn.style.display='none';
    wrap.classList.add('active');
    if(num)num.textContent=qty;
  }else{
    btn.style.display='';
    wrap.classList.remove('active');
  }
}

/* ── BEST SELLERS ── */
function buildBestsellers(products){
  const grid=document.getElementById("bestsellersGrid");
  const bsList=['Kokam Dry Sharbat','Lemonade Dry Sharbat','Coconut Dry Sharbat','Kalakhatta Dry Sharbat'];
  const cards=bsList.map(name=>products.find(p=>p.name===name)).filter(Boolean);
  cards.forEach(p=>registerVariants(p));
  grid.innerHTML=cards.map((p,i)=>buildCard(p,'⭐ Best Seller',i*.08)).join('');
  observeReveal();
}

/* ── ALL PRODUCTS ── */
function buildAllProducts(products){
  const grid=document.getElementById("productsGrid");
  products.forEach(p=>registerVariants(p));
  grid.innerHTML=products.map((p,i)=>buildCard(p,null,(i%4)*.06)).join('');
  observeReveal();loadAllQty();
}
/* ── TESTIMONIALS SLIDER ── */
/* Tab switcher */
function switchTestiTab(tab){
  const reviewsPanel=document.getElementById("reviewsPanel");
  const galleryPanel=document.getElementById("galleryPanel");
  const tabReviews=document.getElementById("tabReviews");
  const tabGallery=document.getElementById("tabGallery");
  if(tab==="reviews"){
    reviewsPanel.classList.add("active");
    galleryPanel.classList.remove("active");
    tabReviews.classList.add("active");
    tabGallery.classList.remove("active");
  } else {
    galleryPanel.classList.add("active");
    reviewsPanel.classList.remove("active");
    tabGallery.classList.add("active");
    tabReviews.classList.remove("active");
  }
}
/* Lightbox */
function openLightbox(el){
  const lb=document.getElementById("galleryLightbox");
  const content=document.getElementById("lightboxContent");
  const img=el.querySelector("img");
  const vid=el.querySelector("video");
  if(img){content.innerHTML=`<img src="${img.src}" alt="${img.alt}">`;}
  else if(vid){content.innerHTML=`<video src="${vid.src}" controls autoplay playsinline style="max-width:90vw;max-height:88vh;border-radius:14px;"></video>`;}
  lb.classList.add("open");
  document.body.style.overflow="hidden";
}
function closeLightbox(){
  document.getElementById("galleryLightbox").classList.remove("open");
  document.getElementById("lightboxContent").innerHTML="";
  document.body.style.overflow="";
}
document.addEventListener("keydown",e=>{if(e.key==="Escape")closeLightbox();});

/* ── GALLERY CAROUSEL ── */
(function(){
  const track=document.getElementById("galleryTrack");
  const dotsWrap=document.getElementById("galleryDots");
  const prevBtn=document.getElementById("galleryPrev");
  const nextBtn=document.getElementById("galleryNext");
  if(!track)return;
  const slides=Array.from(track.querySelectorAll(".gallery-slide"));
  const total=slides.length;
  let current=0,isDragging=false,dragStartX=0,dragStartOffset=0,currentOffset=0;

  slides.forEach((_,i)=>{
    const d=document.createElement("span");
    if(i===0)d.classList.add("active");
    d.addEventListener("click",()=>goGallery(i,true));
    dotsWrap.appendChild(d);
  });

  function getSlideWidth(){return slides[0].offsetWidth+20;}
  function getTargetOffset(idx){
    const sw=getSlideWidth(),ww=track.parentElement.offsetWidth;
    const raw=idx*sw-(ww/2-slides[0].offsetWidth/2)+80;
    return Math.max(0,raw);
  }
  function updateClasses(){
    slides.forEach((s,i)=>{
      s.classList.remove("center","side");
      s.classList.add(i===current?"center":"side");
    });
    dotsWrap.querySelectorAll("span").forEach((d,i)=>d.classList.toggle("active",i===current));
  }
  function applyOffset(o,anim){
    currentOffset=o;
    track.classList.toggle("smooth",anim);
    track.style.transform=`translateX(-${o}px)`;
  }
  function goGallery(n,anim=true){
    current=((n%total)+total)%total;
    applyOffset(getTargetOffset(current),anim);
    updateClasses();
  }

  prevBtn.addEventListener("click",e=>{e.stopPropagation();goGallery(current-1,true);});
  nextBtn.addEventListener("click",e=>{e.stopPropagation();goGallery(current+1,true);});

  track.addEventListener("mousedown",e=>{isDragging=true;dragStartX=e.clientX;dragStartOffset=currentOffset;track.classList.remove("smooth");e.preventDefault();});
  window.addEventListener("mousemove",e=>{if(!isDragging)return;track.style.transform=`translateX(-${dragStartOffset-(e.clientX-dragStartX)}px)`;});
  window.addEventListener("mouseup",e=>{if(!isDragging)return;isDragging=false;const dx=e.clientX-dragStartX;if(Math.abs(dx)>50)dx<0?goGallery(current+1,true):goGallery(current-1,true);else goGallery(current,true);});
  track.addEventListener("touchstart",e=>{dragStartX=e.touches[0].clientX;dragStartOffset=currentOffset;isDragging=true;track.classList.remove("smooth");},{passive:true});
  track.addEventListener("touchmove",e=>{if(!isDragging)return;track.style.transform=`translateX(-${dragStartOffset-(e.touches[0].clientX-dragStartX)}px)`;},{passive:true});
  track.addEventListener("touchend",e=>{isDragging=false;const dx=e.changedTouches[0].clientX-dragStartX;if(Math.abs(dx)>50)dx<0?goGallery(current+1,true):goGallery(current-1,true);else goGallery(current,true);});

  goGallery(0,false);
})();
(function(){
  const track=document.getElementById("testiTrack"),dotsWrap=document.getElementById("testiDots");
  const prevBtn=document.getElementById("testiPrev"),nextBtn=document.getElementById("testiNext");
  const cards=Array.from(track.querySelectorAll(".testi-card"));
  const total=cards.length;
  let current=0,autoTimer=null,isHovered=false,isDragging=false,dragStartX=0,dragStartOffset=0,currentOffset=0;
  cards.forEach((_,i)=>{const d=document.createElement("span");if(i===0)d.classList.add("active");d.addEventListener("click",()=>goTesti(i,true));dotsWrap.appendChild(d);});
  function getCardWidth(){return cards[0].offsetWidth+24;}
  function getTargetOffset(idx){const cw=getCardWidth(),ww=track.parentElement.offsetWidth,raw=idx*cw-(ww/2-cards[0].offsetWidth/2)+80;return Math.max(0,raw);}
  function updateClasses(){cards.forEach((c,i)=>{c.classList.remove("center","side");if(i===current)c.classList.add("center");else c.classList.add("side");});document.querySelectorAll("#testiDots span").forEach((d,i)=>d.classList.toggle("active",i===current));}
  function applyOffset(o,anim){currentOffset=o;if(anim)track.classList.add("smooth");else track.classList.remove("smooth");track.style.transform=`translateX(-${o}px)`;}
  function goTesti(n,anim=true){current=((n%total)+total)%total;applyOffset(getTargetOffset(current),anim);updateClasses();}
  function startAuto(){clearInterval(autoTimer);autoTimer=setInterval(()=>{if(!isHovered&&!isDragging)goTesti(current+1,true);},3000);}
  prevBtn.addEventListener("click",()=>{goTesti(current-1,true);clearInterval(autoTimer);startAuto();});
  nextBtn.addEventListener("click",()=>{goTesti(current+1,true);clearInterval(autoTimer);startAuto();});
  track.addEventListener("mouseenter",()=>{isHovered=true;});
  track.addEventListener("mouseleave",()=>{isHovered=false;});
  track.addEventListener("mousedown",e=>{isDragging=true;dragStartX=e.clientX;dragStartOffset=currentOffset;track.classList.remove("smooth");e.preventDefault();});
  window.addEventListener("mousemove",e=>{if(!isDragging)return;track.style.transform=`translateX(-${dragStartOffset-(e.clientX-dragStartX)}px)`;});
  window.addEventListener("mouseup",e=>{if(!isDragging)return;isDragging=false;const dx=e.clientX-dragStartX;if(Math.abs(dx)>50)dx<0?goTesti(current+1,true):goTesti(current-1,true);else goTesti(current,true);startAuto();});
  track.addEventListener("touchstart",e=>{dragStartX=e.touches[0].clientX;dragStartOffset=currentOffset;isDragging=true;track.classList.remove("smooth");},{passive:true});
  track.addEventListener("touchmove",e=>{if(!isDragging)return;track.style.transform=`translateX(-${dragStartOffset-(e.touches[0].clientX-dragStartX)}px)`;},{passive:true});
  track.addEventListener("touchend",e=>{isDragging=false;const dx=e.changedTouches[0].clientX-dragStartX;if(Math.abs(dx)>50)dx<0?goTesti(current+1,true):goTesti(current-1,true);else goTesti(current,true);startAuto();});
  goTesti(0,false);startAuto();
})();

/* ── CART ── */
let toastTimer=null;
function showCartToast(name,price,image){
  const t=document.getElementById("cartToast");
  document.getElementById("cartToastName").innerText=name;
  document.getElementById("cartToastPrice").innerText="₹"+price+" each";
  const el=document.getElementById("cartToastImg");
  if(image&&el){if(el.tagName==="DIV")el.outerHTML=`<img class="cart-toast-img" id="cartToastImg" src="${image}" onerror="this.outerHTML='<div class=cart-toast-img-placeholder id=cartToastImg>🛒</div>'">`;else el.src=image;}
  t.classList.add("show");
  if(toastTimer)clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>t.classList.remove("show"),3200);
}
function increaseQty(name,price,image,grams){
  let cart=JSON.parse(localStorage.getItem("cart"))||{};
  if(!cart[name])cart[name]={qty:1,price,image,grams};else cart[name].qty++;
  localStorage.setItem("cart",JSON.stringify(cart));updateQtyUI(name);updateCartCount();showCartToast(name,price,image);
}
function decreaseQty(name){
  let cart=JSON.parse(localStorage.getItem("cart"))||{};
  if(!cart[name])return;cart[name].qty--;
  if(cart[name].qty<=0)delete cart[name];
  localStorage.setItem("cart",JSON.stringify(cart));updateQtyUI(name);updateCartCount();
}
function updateQtyUI(name){
  const cart=JSON.parse(localStorage.getItem("cart"))||{};
  const safeId=getSafeId(name);const qty=cart[name]?.qty||0;
  document.querySelectorAll(`[id="qty-${safeId}"],[id="qty-bs-${safeId}"]`).forEach(el=>el.innerText=qty);
}
function updateCartCount(){
  const cart=JSON.parse(localStorage.getItem("cart"))||{};
  let t=0;Object.values(cart).forEach(i=>t+=i.qty);
  document.querySelectorAll("#cartCount,#mobCartCount").forEach(el=>el.textContent=t);
}
function loadAllQty(){
  const cart=JSON.parse(localStorage.getItem("cart"))||{};
  Object.keys(cart).forEach(name=>{
    updateQtyUI(name);
    /* restore qty counter on cards */
    const safeId=getSafeId(name);
    _syncCardQty(safeId,name);
  });
  updateCartCount();
}

function openWhatsAppChannel(){
  window.open(
    "https://whatsapp.com/channel/0029VbBlKHCDeONGN7mjrY0A",
    "_blank"
  );
}

function openTaleWhatsApp(){
  window.open("https://talelightmedia.in/", "_blank");
}

function handleBuy(n,p,img,g){increaseQty(n,p,img,g);}
window.onload=loadAllQty;
</script>
</body>
</html>